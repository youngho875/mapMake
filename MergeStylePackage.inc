void PackageMergeStyles(const std::vector<MergeGroup>& groups,TileResult& result){
 auto path=result.folder/"map-sources.xml";std::unique_ptr<CPLXMLNode,decltype(&CPLDestroyXMLNode)> doc(CPLParseXMLFile(path.u8string().c_str()),CPLDestroyXMLNode);if(!doc)return;auto root=doc.get();while(root&&std::string(root->pszValue)!="MapSources")root=root->psNext;if(!root)return;
 auto key=[](std::string s){s=MergeLower(s);for(auto suffix:{"_tmk","_mok","_jop","_tsm","_tsp","_air1m","_air2m","_air250k","_air500k","_navykr1","_navykr2","_navykr3","_navykr4","_navykr5"}){std::string end=suffix;if(s.size()>end.size()&&s.substr(s.size()-end.size())==end)s.resize(s.size()-end.size());}return s;};
 for(size_t i=0;i<groups.size();++i){auto& g=groups[i];auto scale=g.scale;if(!scale.empty()&&scale.back()=='m')scale.pop_back();auto file=fs::path(L"D:/map/styles")/("cop_"+g.family+"_"+scale+"_unix.xml");if(!fs::exists(file)){result.messages.push_back("STYLE: no matching XML for "+g.key);continue;}
  auto layer=root->psChild;auto id=result.folder.filename().u8string()+"_"+std::to_string(i+1);auto legacyId="mvt_"+std::to_string(i+1);while(layer&&(layer->eType!=CXT_Element||(std::string(CPLGetXMLValue(layer,"id",""))!=id&&std::string(CPLGetXMLValue(layer,"id",""))!=legacyId)))layer=layer->psNext;if(!layer)continue;
  auto profile=LoadCop(file);bool found=false,visible=false;std::string alias,source,category;for(auto& l:profile.layers){l.enabled=key(l.source)==key(g.code);if(l.enabled){l.target=g.code;l.manualTarget=true;found=true;visible=visible||l.visible;if(alias.empty()){alias=l.alias;source=l.source;category=l.category;}}}
  if(!found){result.messages.push_back("STYLE: XML layer not matched: "+g.key);continue;}
  CopOptions options;options.gssRoot=L"D:/map/styles/GSS";options.transparency=2;auto artifacts=BuildCop({profile},options);auto folder=result.folder/"styles"/std::to_string(i+1);fs::create_directories(folder);fs::path sld;
  for(auto& artifact:artifacts){auto target=folder/artifact.name;fs::create_directories(target.parent_path());std::ofstream out(target,std::ios::binary);out.write(artifact.content.data(),artifact.content.size());if(!out)throw std::runtime_error("Cannot save packaged style");if(target.extension()==L".sld")sld=target;}
  auto local=folder/file.filename();fs::copy_file(file,local,fs::copy_options::overwrite_existing);
  if(!sld.empty())CPLSetXMLValue(layer,"StyleSLD",fs::absolute(sld).u8string().c_str());CPLSetXMLValue(layer,"LocalStyleXML",fs::absolute(local).u8string().c_str());CPLSetXMLValue(layer,"LocalLayerName",source.c_str());CPLSetXMLValue(layer,"LayerName",g.code.c_str());CPLSetXMLValue(layer,"#name",(alias.empty()?g.code:alias).c_str());CPLSetXMLValue(layer,"#family",g.family=="land"?u8"육도":g.family=="air"?u8"공도":g.family=="kr"?u8"해도":g.family.c_str());CPLSetXMLValue(layer,"Category",category.c_str());CPLSetXMLValue(layer,"Scale",std::to_string(std::atof(scale.c_str())*10000).c_str());CPLSetXMLValue(layer,"visual",visible?"true":"false");
  result.messages.push_back("STYLE: "+g.key+" -> "+source+" / "+alias+" / "+sld.u8string());
 }
 if(!CPLSerializeXMLTreeToFile(doc.get(),path.u8string().c_str()))throw std::runtime_error("Cannot save style mapping XML");
}
