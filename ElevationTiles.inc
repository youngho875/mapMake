// Lossless source-grid DEM tiles: no byte conversion, reprojection or resampling.
TileResult MakeElevationTiles(const std::vector<Layer>& layers,const TileOptions& opt,std::atomic_bool& cancel,const std::function<void(const std::string&)>& progress,const TileProgress& numeric){
 Runtime(opt.gdalDll);TileResult result;result.folder=opt.output/("dem_"+std::to_string(std::chrono::system_clock::now().time_since_epoch().count()));fs::create_directories(result.folder);
 size_t index=0;uint64_t total=0,done=0;for(auto& layer:layers){auto ds=Own(GDALOpenEx(layer.local.u8string().c_str(),GDAL_OF_RASTER,nullptr,nullptr,nullptr));if(!ds||ds->GetRasterCount()!=1)throw std::runtime_error("DEM must be a readable single-band raster: "+layer.local.u8string());double gt[6];if(ds->GetGeoTransform(gt)!=CE_None||(!ds->GetSpatialRef()&&opt.fallbackEpsg<=0))throw std::runtime_error("DEM needs georeferencing and CRS: "+layer.local.u8string());total+=((uint64_t(ds->GetRasterXSize())+511)/512)*((uint64_t(ds->GetRasterYSize())+511)/512);}
 if(opt.maxTiles&&total>opt.maxTiles)throw std::runtime_error("DEM tile count exceeds limit; raise the tile limit.");
 for(auto& layer:layers){if(cancel)break;++index;auto ds=Own(GDALOpenEx(layer.local.u8string().c_str(),GDAL_OF_RASTER,nullptr,nullptr,nullptr));if(!ds)throw std::runtime_error("Cannot reopen DEM");auto dir=result.folder/(std::to_string(index)+"_"+layer.local.stem().u8string());fs::create_directories(dir);
  for(int y=0;y<ds->GetRasterYSize()&&!cancel;y+=512)for(int x=0;x<ds->GetRasterXSize()&&!cancel;x+=512){
   auto target=dir/(std::to_string(y/512)+"_"+std::to_string(x/512)+".tif");auto partial=target;partial+=".partial.tif";
   Args args{"-of","GTiff","-srcwin",std::to_string(x),std::to_string(y),std::to_string(std::min(512,ds->GetRasterXSize()-x)),std::to_string(std::min(512,ds->GetRasterYSize()-y)),"-co","TILED=YES","-co","COMPRESS=DEFLATE","-co","BIGTIFF=IF_SAFER"};
   if(!ds->GetSpatialRef()){args.strings.push_back("-a_srs");args.strings.push_back("EPSG:"+std::to_string(opt.fallbackEpsg));}
   auto options=GDALTranslateOptionsNew(args.get(),nullptr);GDALTranslateOptionsSetProgress(options,Progress,&cancel);auto output=Own(GDALTranslate(partial.u8string().c_str(),ds.get(),options,nullptr));GDALTranslateOptionsFree(options);
   if(!output||cancel){output.reset();std::error_code ec;fs::remove(partial,ec);if(cancel)break;throw std::runtime_error("Cannot write DEM tile");}auto inBand=ds->GetRasterBand(1);auto outBand=output->GetRasterBand(1);int present=0;double value=inBand->GetScale(&present);if(present)outBand->SetScale(value);value=inBand->GetOffset(&present);if(present)outBand->SetOffset(value);outBand->SetUnitType(inBand->GetUnitType());output.reset();fs::rename(partial,target);++result.written;++done;if(numeric)numeric(1,1,done,total);progress("DEM "+std::to_string(done)+"/"+std::to_string(total));
  }result.messages.push_back(layer.local.u8string()+" -> "+dir.u8string());
 }
 result.cancelled=cancel;auto xml=CPLCreateXMLNode(nullptr,CXT_Element,"BaseMap");CPLSetXMLValue(xml,"Elevation.Path",fs::absolute(result.folder).u8string().c_str());CPLSetXMLValue(xml,"Elevation.visual","false");CPLSetXMLValue(xml,"Elevation.Format","GeoTIFFSourceGrid");CPLSetXMLValue(xml,"Elevation.VerticalReference","source");CPLSerializeXMLTreeToFile(xml,(result.folder/"base-map-elevation.xml").u8string().c_str());CPLDestroyXMLNode(xml);
 std::ofstream report(result.folder/"result.txt");report<<"Lossless 512x512 source-grid GeoTIFF DEM tiles; edges may be smaller. Original CRS, sample type, scale/offset, NoData and vertical reference retained. Not XYZ images.\nwritten="<<result.written<<" cancelled="<<result.cancelled<<"\n";for(auto& m:result.messages)report<<m<<"\n";return result;
}
